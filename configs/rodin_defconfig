# Rodin (Redmi Turbo 4 / POCO X7 Pro) device defconfig.
# Syntax matches Linux defconfig. Applied after the fragments listed in
# [kernel] config_fragments. Each CONFIG_XNU_<NAME> becomes XNU_<NAME> in
# the kernel build. {tree} in a string expands to the build tree path.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMVIRT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# Opt in to the archive builders. The real kernel build (XNU_BOOTSTRAP=0) links
# source-derived archives (e.g. build/corecrypto-2023/libcorecrypto_kernel_noasm-namespaced.a)
# produced by the [kernel] archives recipes; the bootstrap pass leaves this unset.
CONFIG_XNU_BUILD_ARCHIVES=y

# Owner volume UUIDs are only consumed when the owner boot manifest / scratch
# Data mount are enabled (XNU_OWNER_BOOT_MANIFEST / XNU_OWNER_DATA_MOUNT). This
# bring-up configuration keeps both off, so the kernel uses its defaults.
# Fill these with the observed APFS volume UUIDs before the first real boot:
#   CONFIG_XNU_OWNER_DATA_VOLUME_UUID="the scratch Data volume UUID"
#   CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="the SystemOS cryptex volume UUID"
#   CONFIG_XNU_OWNER_ROOT_VOLUME_UUID="[root] os_volume_uuid of the OS profile"
# A placeholder such as "REQUIRED_<uuid>" is not a UUID and aborts the build
# bootstrap step in scripts/build-xnu-4k-baseline.sh (uuid.UUID ValueError).
